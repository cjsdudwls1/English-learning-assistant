-- =============================================================
-- 【보류 — 적용하지 말 것】 parent_children 승인 게이트 (안2)
--
-- ■ 확장자가 `.sql.HOLD` 인 이유
--   `supabase db push` 는 migrations/ 안의 미적용 `<timestamp>_<name>.sql` 을 파일명 순으로
--   **전부** 적용한다. 골라서 적용하는 옵션이 없다. 그래서 "커밋은 하되 적용은 막는" 유일한
--   방법이 확장자를 벗기는 것이다. 적용하기로 결정하면 `.HOLD` 를 떼면 된다.
--   원래는 `20260829020000_restrict_role_and_parent_link.sql` 의 뒤쪽 절반이었다.
--   앞쪽 절반(profiles 역할 상승 차단)은 안전해서 `20260829020000_restrict_role_escalation.sql`
--   로 분리해 두었다 — 그쪽은 그대로 적용해도 된다.
--
-- ■ 보류 사유 (승인 UI 가 없다는 것보다 심각하다)
--   아래 pc_insert 는 학부모의 자가 연결을 **강제로 status='pending'** 으로 넣는다.
--   그리고 pc_update(=승인) 는 다음 둘만 허용한다:
--     (1) get_user_role(auth.uid()) = 'director'
--     (2) 그 **자녀가 student 로 등록된 class 의 관리자**인 교사
--   따라서 **어느 학급에도 속하지 않은 학생**은 (2)의 경로가 아예 성립하지 않는다.
--   원장 계정이 직접 승인해 주지 않는 한, 그 학부모의 자녀 연결은 **영구히 pending** 이다.
--   현재 앱에는 승인 화면 자체가 없으므로(아래 [프론트 후속 작업] 참고) 실질적으로
--   "학부모 기능이 전부 죽는다".
--
-- ■ 적용 전에 반드시 정해야 할 것 (제품 결정)
--   (a) 승인 화면을 만든다 — 교사/원장용 pending 목록 + 승인 버튼. 그리고 학급 미소속
--       학생을 위한 경로(원장 전용 화면 또는 학생 본인 승인)를 같이 만든다.
--   또는
--   (b) status DEFAULT 를 'approved' 로 두고 게이트를 **휴면 상태**로 넣는다.
--       컬럼·인덱스·정책은 미리 깔되 실제 차단은 나중에 켠다.
--
-- ■ 또 하나의 함정 (이 파일과 별개로 이미 존재하는 위험)
--   `English-learning-assistant/supabase/migrations/unify_rls_policies_for_stats_perf.sql:14`
--   가 `can_access_user_data` 를 CREATE OR REPLACE 하는데 parent_children 을 **status 필터
--   없이** 조인한다. 그 디렉토리는 Supabase CLI 관리 밖이고 `scripts/_apply.py` 가 적용하며
--   "이미 적용됨" 원장(ledger)이 없다. 이 파일을 적용한 뒤 그 스크립트가 다시 돌면
--   승인 게이트가 조용히 무력화된다. 순서를 반드시 확인할 것.
--
-- [적용 시 사라지는 기능]
--   1. 학부모의 자녀 연결이 **즉시 유효**하지 않게 된다. 연결은 status='pending' 으로
--      들어가고 그 학생이 속한 학급의 교사나 원장이 승인해야 자녀 데이터가 보인다.
--   2. 교사가 **자기 학급이 아닌** 학생에게 학부모를 연결하거나 남의 연결을 삭제하던 동작이 막힌다.
--      (원장은 그대로 전체 가능.)
--   3. 교사의 parent_children 조회 범위가 "플랫폼 전체"에서 "자기 학급 학생"으로 좁아진다.
--   4. **어느 학급에도 속하지 않은 학생**은 교사가 연결/승인할 수 없다(class_members 로 학급을
--      찾기 때문이다). 그 학생의 연결은 원장만 승인할 수 있다. 학생을 먼저 학급에 넣으면 해결된다.
--
-- [프론트 후속 작업 — 이 파일에는 포함되지 않음]
--   - parentChildren.ts:11-28 linkChild: 성공 메시지를 "승인 대기"로 바꿔야 한다.
--   - parentChildren.ts:30-53 fetchMyChildren: status 를 함께 읽어 pending 을 구분 표시해야 한다.
--     (지금은 pending 연결도 자녀 목록에 뜨는데 데이터는 비어 보인다.)
--   - 교사/원장용 승인 화면이 필요하다: status='pending' 목록 조회 + UPDATE status='approved'.
--   - academies.ts:205-232 fetchParentsByStudent 는 status 필터가 없어 원장 화면에서
--     pending 연결도 학부모로 표시된다.
--
-- 재적용 가능하다: 컬럼 추가는 존재 확인 후, 제약은 DROP...IF EXISTS 후 ADD,
-- 정책은 DROP POLICY IF EXISTS 선행, 함수는 CREATE OR REPLACE.
-- =============================================================


-- #####################################################################
-- 2-2. parent_children 무단 연결 (안2 — 승인 상태 도입)
--
-- before (20260328000000:163-172):
--   CREATE POLICY "pc_select" ON parent_children FOR SELECT USING (
--     parent_id = auth.uid() OR child_id = auth.uid()
--     OR get_user_role(auth.uid()) IN ('teacher', 'director')
--   );
--   CREATE POLICY "pc_insert" ON parent_children FOR INSERT WITH CHECK (
--     parent_id = auth.uid() OR get_user_role(auth.uid()) IN ('teacher','director')
--   );
--   CREATE POLICY "pc_delete" ON parent_children FOR DELETE USING (
--     parent_id = auth.uid() OR get_user_role(auth.uid()) IN ('teacher','director')
--   );
--
-- (a) 로그인만 되면 (parent_id=나, child_id=아무나) 를 넣어 그 학생의 풀이기록·문제·정오답·
--     과제응답을 전부 읽을 수 있다. is_parent_of 기반 정책들(20260328000002:7,
--     20260708000000:30, 20260826000000:63)과 can_access_user_data(unify_rls_policies_for_stats_perf.sql:14)가
--     전부 "연결 행이 있으면 참"이기 때문이다.
-- (b) 교사 역할이면 자기 반도 자기 학원도 아닌 학생에게 같은 짓을 할 수 있고,
--     남의 자녀 연결을 지울 수도 있다.
--
-- 채택: **안2(스키마 변경)**. 자가 연결은 pending 으로만 들어가고 교사/원장이 승인한다.
--   기능(학부모의 자녀 연결)이 보존되기 때문이다.
-- 대안 안1(스키마 변경 없음)은 파일 맨 아래 주석에 남겼다.
-- #####################################################################

-- status 컬럼 추가 + 기존 행 백필.
-- ADD COLUMN 과 백필을 하나의 IF 안에 둔 이유: 재적용 시 백필이 다시 돌면
-- **진짜 승인 대기 중인 행까지 승인**되어 버린다. 컬럼이 없을 때만(=최초 적용) 실행한다.
DO $do$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM information_schema.columns
    WHERE table_schema = 'public'
      AND table_name = 'parent_children'
      AND column_name = 'status'
  ) THEN
    ALTER TABLE public.parent_children
      ADD COLUMN status TEXT NOT NULL DEFAULT 'pending';
    -- 이미 쓰이고 있는 연결은 전부 승인 상태로 — 현재 사용자가 깨지지 않게.
    UPDATE public.parent_children SET status = 'approved';
  END IF;
END
$do$;

ALTER TABLE public.parent_children DROP CONSTRAINT IF EXISTS parent_children_status_check;
ALTER TABLE public.parent_children ADD CONSTRAINT parent_children_status_check
  CHECK (status IN ('pending', 'approved'));

CREATE INDEX IF NOT EXISTS idx_pc_child_status ON public.parent_children(child_id, status);

-- is_parent_of 를 승인된 연결만 인정하도록 교체.
-- 시그니처(파라미터 이름·타입·반환형)는 20260328000000:117-122 와 동일하게 유지한다 —
-- 이름이 다르면 CREATE OR REPLACE 가 "cannot change name of input parameter" 로 실패한다.
CREATE OR REPLACE FUNCTION is_parent_of(parent_uid UUID, child_uid UUID)
RETURNS BOOLEAN AS $$
  SELECT EXISTS (
    SELECT 1 FROM parent_children
    WHERE parent_id = parent_uid
      AND child_id = child_uid
      AND status = 'approved'
  );
$$ LANGUAGE sql SECURITY DEFINER STABLE;

-- can_access_user_data 는 is_parent_of 를 쓰지 않고 parent_children 을 **직접** 본다
-- (unify_rls_policies_for_stats_perf.sql:14). 그대로 두면 sessions/problems/labels 가
-- pending 연결에도 열린 채로 남는다. 학부모 분기만 is_parent_of 경유로 바꾼다 — 나머지는 원문과 동일.
CREATE OR REPLACE FUNCTION public.can_access_user_data(viewer_uid uuid, target_uid uuid)
RETURNS boolean
LANGUAGE sql
STABLE SECURITY DEFINER
SET search_path = public
AS $$
  SELECT CASE
    WHEN viewer_uid IS NULL THEN false
    WHEN viewer_uid = target_uid THEN true
    WHEN is_parent_of(viewer_uid, target_uid) THEN true
    WHEN (SELECT COALESCE(role, 'student') FROM profiles WHERE user_id = viewer_uid) = 'director' THEN true
    WHEN EXISTS (
      SELECT 1 FROM class_members cm
      WHERE cm.user_id = target_uid AND cm.role = 'student'
        AND (
          EXISTS (SELECT 1 FROM class_members tcm WHERE tcm.user_id = viewer_uid AND tcm.class_id = cm.class_id AND tcm.role = 'teacher')
          OR EXISTS (SELECT 1 FROM classes c WHERE c.id = cm.class_id AND c.created_by = viewer_uid)
        )
    ) THEN true
    ELSE false
  END
$$;

-- can_view_assignment 의 학부모 분기도 parent_children 직접 조인이다(20260329000000:9-13).
-- 의미를 바꾸지 않고 is_parent_of 경유로만 돌린다 → status 검사가 자동으로 따라온다.
CREATE OR REPLACE FUNCTION can_view_assignment(uid UUID, aid UUID)
RETURNS BOOLEAN AS $$
  SELECT EXISTS (SELECT 1 FROM shared_assignments WHERE id = aid AND created_by = uid)
  OR EXISTS (SELECT 1 FROM assignment_targets WHERE assignment_id = aid AND student_id = uid)
  OR get_user_role(uid) = 'director'
  OR EXISTS (
    SELECT 1 FROM assignment_targets at2
    WHERE at2.assignment_id = aid AND is_parent_of(uid, at2.student_id)
  )
  OR EXISTS (
    SELECT 1 FROM shared_assignments sa
    WHERE sa.id = aid AND sa.class_id IS NOT NULL
      AND is_class_admin(uid, sa.class_id)
  );
$$ LANGUAGE sql SECURITY DEFINER STABLE;

-- 주의: 20260329000000 / 20260829000000 을 **나중에 다시 적용하면** 위 두 함수가
-- parent_children 직접 조인 버전으로 되돌아간다(= status 검사 소실).
-- 20260829010000 은 이미 is_parent_of 경유로 고쳐 두었으므로 재적용해도 안전하다.
--
-- **더 위험한 것이 하나 더 있다 — 이쪽은 타임스탬프가 없어서 순서로 막히지도 않는다:**
--   English-learning-assistant/supabase/migrations/unify_rls_policies_for_stats_perf.sql:14
--   이 파일은 can_access_user_data 를 CREATE OR REPLACE 하면서 parent_children 을
--   status 조건 **없이** 직접 조인한다. 그리고 이 디렉터리는 Supabase CLI 가 관리하지 않고
--   scripts/_apply.py 가 파일명 순서로 돌린다 — 즉 "이미 적용됨" 기록이 없어 누가 언제
--   다시 돌려도 이상해 보이지 않고, 돌리는 순간 위 학부모 status 게이트가 통째로 사라진다.
--   저 파일을 손볼 일이 생기면 14행을 is_parent_of(viewer_uid, target_uid) 로 먼저 바꿀 것.

-- 정책 교체 --------------------------------------------------------------

-- SELECT: 교사는 "자기 학급 학생"의 연결만 본다. (before: 아무 교사나 전체 열람)
DROP POLICY IF EXISTS "pc_select" ON parent_children;
CREATE POLICY "pc_select" ON parent_children FOR SELECT USING (
  parent_id = auth.uid()
  OR child_id = auth.uid()
  OR get_user_role(auth.uid()) = 'director'
  OR EXISTS (
    SELECT 1 FROM class_members cm
    WHERE cm.user_id = parent_children.child_id
      AND cm.role = 'student'
      AND is_class_admin(auth.uid(), cm.class_id)
  )
);

-- INSERT: 학부모 자가 연결은 pending 으로만. 교사는 자기 학급 학생에 한해.
-- parent_children 에 학급 정보가 없으므로 class_members 를 EXISTS 로 조인한다.
-- (WITH CHECK 은 DEFAULT 적용 후의 최종 행을 검사하므로, status 를 보내지 않는
--  linkChild(parentChildren.ts:22-24)는 DEFAULT 'pending' 으로 통과한다.
--  status:'approved' 를 직접 실어 보내는 우회는 여기서 거절된다.)
DROP POLICY IF EXISTS "pc_insert" ON parent_children;
CREATE POLICY "pc_insert" ON parent_children FOR INSERT WITH CHECK (
  (parent_id = auth.uid() AND status = 'pending')
  OR get_user_role(auth.uid()) = 'director'
  OR EXISTS (
    SELECT 1 FROM class_members cm
    WHERE cm.user_id = parent_children.child_id
      AND cm.role = 'student'
      AND is_class_admin(auth.uid(), cm.class_id)
  )
);

-- UPDATE: 승인용. 원래 parent_children 에는 UPDATE 정책이 없었다(= 아무도 승인할 수 없다).
-- 학부모에게는 UPDATE 정책을 주지 않는다 — 자기가 만든 pending 을 스스로 승인하면 의미가 없다.
DROP POLICY IF EXISTS "pc_update" ON parent_children;
CREATE POLICY "pc_update" ON parent_children FOR UPDATE
  USING (
    get_user_role(auth.uid()) = 'director'
    OR EXISTS (
      SELECT 1 FROM class_members cm
      WHERE cm.user_id = parent_children.child_id
        AND cm.role = 'student'
        AND is_class_admin(auth.uid(), cm.class_id)
    )
  )
  WITH CHECK (
    get_user_role(auth.uid()) = 'director'
    OR EXISTS (
      SELECT 1 FROM class_members cm
      WHERE cm.user_id = parent_children.child_id
        AND cm.role = 'student'
        AND is_class_admin(auth.uid(), cm.class_id)
    )
  );

-- DELETE: INSERT 와 같은 기준. 학부모는 자기 연결만, 교사는 자기 학급 학생만, 원장은 전체.
DROP POLICY IF EXISTS "pc_delete" ON parent_children;
CREATE POLICY "pc_delete" ON parent_children FOR DELETE USING (
  parent_id = auth.uid()
  OR get_user_role(auth.uid()) = 'director'
  OR EXISTS (
    SELECT 1 FROM class_members cm
    WHERE cm.user_id = parent_children.child_id
      AND cm.role = 'student'
      AND is_class_admin(auth.uid(), cm.class_id)
  )
);

-- ---------------------------------------------------------------------
-- 채택하지 않은 안1(스키마 변경 없음) — 자가 연결 분기 제거, 교사/원장만 연결 가능.
-- 학부모 화면의 자녀 연결 기능(parentChildren.ts:11-28 linkChild)이 통째로 사라진다.
-- status 컬럼과 위 pc_* 정책 대신 이것만 쓰면 된다:
--
-- DROP POLICY IF EXISTS "pc_insert" ON parent_children;
-- CREATE POLICY "pc_insert" ON parent_children FOR INSERT WITH CHECK (
--   get_user_role(auth.uid()) = 'director'
--   OR EXISTS (
--     SELECT 1 FROM class_members cm
--     WHERE cm.user_id = parent_children.child_id
--       AND cm.role = 'student'
--       AND is_class_admin(auth.uid(), cm.class_id)
--   )
-- );
--
-- 근본적으로: 학부모 자가 연결은 **동의 절차가 없으면 막을 수 없다.** 안2의 승인 절차가
-- 그 동의를 교사/원장에게 위임한 것이고, 안1은 자가 연결 자체를 없앤 것이다.
-- ---------------------------------------------------------------------
